{
  "name": "x402-receipts",
  "version": "0.2.0",
  "description": "Signed, offline-verifiable receipts for x402 payments (chain-agnostic, ed25519 + RFC 8785 JCS).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "SPEC.md", "docs", "vectors"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "vectors": "node --import tsx scripts/run-vectors.ts",
    "vectors:gen": "node --import tsx scripts/gen-vectors.ts",
    "example:server": "node --import tsx examples/x402-express/server.ts",
    "example:client": "node --import tsx examples/x402-express/client.ts",
    "canton:demo": "node --import tsx scripts/canton-localnet-demo.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "express": "^4.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
