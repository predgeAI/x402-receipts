module ReceiptTest where

import DA.Assert ((===))
import DA.Date (Month(..), date)
import DA.Time (time, addRelTime, convertMicrosecondsToRelTime)
import DA.Optional (isNone, isSome)
import Daml.Script
import X402.Receipt

data Parties = Parties with merchant : Party; agent : Party; outsider : Party

setupParties : Script Parties
setupParties = do
  merchant <- allocatePartyByHint (PartyIdHint "test-merchant")
  agent <- allocatePartyByHint (PartyIdHint "test-agent")
  outsider <- allocatePartyByHint (PartyIdHint "outsider")
  pure Parties with ..

-- 1. The issuer records a receipt; the payer sees it, a non-stakeholder does not.
test_create_and_visibility : Script ()
test_create_and_visibility = do
  Parties{..} <- setupParties
  cid <- submit merchant do createCmd (vectorReceipt merchant agent)
  seenByPayer <- queryContractId agent cid
  assertMsg "payer must see the record" (isSome seenByPayer)
  fmap (.receiptId) seenByPayer === Some "0192f3a0-7b1e-7c3a-9d52-5a1c0e7b4f20"
  fmap (.canonical) seenByPayer === Some (vectorReceipt merchant agent).canonical
  seenByOutsider <- queryContractId outsider cid
  assertMsg "outsider must not see the record" (isNone seenByOutsider)
  outsiderAll <- query @ReceiptRecord outsider
  outsiderAll === []

-- 2. Only the issuer can create a record in its name.
test_only_issuer_can_create : Script ()
test_only_issuer_can_create = do
  Parties{..} <- setupParties
  submitMustFail agent do createCmd (vectorReceipt merchant agent)
  submitMustFail outsider do createCmd (vectorReceipt merchant agent)

-- 3. Fields that are also in the signed canonical text must agree with it.
test_ensure_rejects_inconsistent_fields : Script ()
test_ensure_rejects_inconsistent_fields = do
  Parties{..} <- setupParties
  let r = vectorReceipt merchant agent
  submitMustFail merchant do createCmd r with amount = "2000000000"
  submitMustFail merchant do createCmd r with amount = "01000000000"
  submitMustFail merchant do createCmd r with settlementUpdateId = "1220deadbeef"
  submitMustFail merchant do createCmd r with receiptId = "other-id"
  submitMustFail merchant do createCmd r with envelopeHash = "sha256:XYZ"
  submitMustFail merchant do createCmd r with payer = merchant

-- 4. Duplicate receiptId. Daml 3 (LF 2) has no contract keys, so the ledger does NOT reject a
-- second record with the same (issuer, receiptId). This test pins that behaviour; issuers must
-- dedupe before submitting (scripts/canton-localnet-demo.ts queries the ACS first), and readers
-- should treat (issuer, receiptId) as the identity and the oldest record as authoritative.
test_duplicate_receipt_id_not_rejected_by_ledger : Script ()
test_duplicate_receipt_id_not_rejected_by_ledger = do
  Parties{..} <- setupParties
  let r = vectorReceipt merchant agent
  _ <- submit merchant do createCmd r
  _ <- submit merchant do createCmd r
  recs <- query @ReceiptRecord agent
  let same = filter (\(_, x) -> x.issuer == merchant && x.receiptId == r.receiptId) recs
  length same === 2

-- 5. The payer acknowledges: the record is replaced by one signed by both parties.
test_acknowledge : Script ()
test_acknowledge = do
  Parties{..} <- setupParties
  cid <- submit merchant do createCmd (vectorReceipt merchant agent)
  submitMustFail merchant do exerciseCmd cid Acknowledge
  submitMustFail outsider do exerciseCmd cid Acknowledge
  ackCid <- submit agent do exerciseCmd cid Acknowledge
  gone <- queryContractId merchant cid
  assertMsg "original record is archived" (isNone gone)
  ackByIssuer <- queryContractId merchant ackCid
  ackByPayer <- queryContractId agent ackCid
  ackByOutsider <- queryContractId outsider ackCid
  assertMsg "issuer sees acknowledgement" (isSome ackByIssuer)
  assertMsg "payer sees acknowledgement" (isSome ackByPayer)
  assertMsg "outsider does not" (isNone ackByOutsider)
  fmap (.receipt.envelopeHash) ackByPayer === Some (vectorReceipt merchant agent).envelopeHash

-- 6. Issuer can withdraw an unacknowledged record (standard Archive); the payer cannot.
test_archive_by_issuer_only : Script ()
test_archive_by_issuer_only = do
  Parties{..} <- setupParties
  cid <- submit merchant do createCmd (vectorReceipt merchant agent)
  submitMustFail agent do archiveCmd cid
  submit merchant do archiveCmd cid
  gone <- queryContractId agent cid
  assertMsg "archived" (isNone gone)

-- Generated from vectors/valid-canton-001.json (TEST-ONLY key, synthetic devnet ids).
vectorReceipt : Party -> Party -> ReceiptRecord
vectorReceipt issuer payer = ReceiptRecord with
  issuer
  payer
